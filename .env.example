# Public build-time settings for the browser app. Copy to .env.local.
#
# Every VITE_ value ends up inside the public JavaScript bundle, so only
# public values belong here.

# Optional. A Cesium ion access token, restricted in the Cesium ion dashboard
# to http://localhost:5173 and http://localhost:4173. Without it, the globe
# uses the low-resolution imagery bundled with Cesium.
VITE_CESIUM_ION_TOKEN=
