{
  "name": "orbitalgaze",
  "version": "0.2.1",
  "private": true,
  "license": "UNLICENSED",
  "description": "Interactive 3D globe for exploring public webcams around the world.",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cf-typegen": "wrangler types",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .git/info/exclude --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .git/info/exclude --ignore-path .prettierignore",
    "lint": "eslint . && markdownlint-cli2",
    "typecheck": "wrangler types --check && tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:seed": "pnpm db:migrate && node scripts/seed.ts",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e",
    "deploy:staging": "CLOUDFLARE_ENV=staging vite build && wrangler d1 migrations apply DB --remote --env staging && wrangler deploy",
    "deploy:production": "CLOUDFLARE_ENV=production vite build && wrangler d1 migrations apply DB --remote --env production && wrangler deploy"
  },
  "dependencies": {
    "@photostructure/tz-lookup": "^11.8.0",
    "@sentry/browser": "11.13.0",
    "@sentry/cloudflare": "11.13.0",
    "cesium": "^1.147.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "hono": "^4.13.18",
    "lucide-react": "^1.73.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "gts": "^7.0.0",
    "jsdom": "^31.0.1",
    "markdownlint-cli2": "^0.24.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.12",
    "wrangler": "^4.162.0"
  }
}
