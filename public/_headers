# Security headers for static files (the app page, scripts, and the map's
# fonts and icons). API responses, including the map tiles, get their
# headers from the Worker instead.
#
# The browser enforces this policy and sends violation categories to the API.
# - worker-src 'self' blob:: the map library parses tiles in web workers
#   started from our own script file.
# - style-src 'unsafe-inline': UI components inject small inline styles
#   (for example scroll areas).
# - img-src imgproxy.windy.com and frame-src webcams.windy.com: Windy camera
#   images and timelapse players, which Windy's terms require loading from
#   Windy itself. They match the Windy source's allowed hosts on the server.
# - script-src static.cloudflareinsights.com: Cloudflare Web Analytics, which
#   the edge adds to production pages (a zone rule keeps it off staging). It
#   is cookieless and reports to our own /cdn-cgi/rum, so 'self' covers that.
# - The map's tiles, fonts and icons all come from our own origin ('self').
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://imgproxy.windy.com; connect-src 'self' https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://*.ingest.de.sentry.io; font-src 'self'; frame-src https://webcams.windy.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; report-uri /api/v1/csp-reports

# Map fonts and icons never change under a given path; a week is safe.
/basemap/*
  Cache-Control: public, max-age=604800
