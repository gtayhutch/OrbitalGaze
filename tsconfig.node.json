{
  // Tooling that runs in Node.js: build and test configs, scripts, and the
  // end-to-end tests.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.cache/tsc/node.tsbuildinfo",
    "lib": ["ES2024"],
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.*.config.ts",
    "playwright.config.ts",
    "scripts",
    "tests"
  ]
}
