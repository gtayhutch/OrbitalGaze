// Cloudflare Worker configuration for OrbitalGaze.
//
// One Worker serves both halves of the app:
//   - the React single-page app as static assets (built by Vite into dist/), and
//   - the JSON API under /api/*, handled by src/worker/index.ts.
//
// Environments:
//   - The top level of this file is the LOCAL environment used by `pnpm dev`
//     and the tests. It deliberately has no account ID, routes, or remote
//     bindings, so a bare deploy can't reach a real Cloudflare account.
//   - `env.staging` and `env.production` describe the hosted environments.
//     Both live in the one Cloudflare account that holds orbitalgaze.com, as
//     separate Workers with separate databases, buckets, queues, and
//     secrets: a Worker can only use a custom domain on a zone in its own
//     account. No resource is shared between the two blocks. Account and
//     resource IDs are not secrets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orbitalgaze",
  "main": "./src/worker/index.ts",

  // The runtime behavior date. Advancing it is a deliberate change made in
  // its own pull request, with the full test suite run.
  "compatibility_date": "2026-11-17",
  // The diagnostics SDK uses Node's AsyncLocalStorage for request isolation.
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    // Unknown paths return index.html so the client-side app can route them.
    "not_found_handling": "single-page-application",
    // Only API paths run Worker code first; everything else is a static file.
    "run_worker_first": ["/api/*"],
  },

  "observability": {
    "enabled": true,
    "traces": {"enabled": true},
  },

  // Non-secret settings. Secrets are never stored in this file.
  "vars": {
    "APP_ENV": "test",
    // The basemap archive's object key in the BASEMAP bucket. Archives are
    // versioned by key; switching basemaps is a new key here, never an
    // overwrite. Locally the bucket is empty until a basemap is seeded.
    "BASEMAP_ARCHIVE": "planet/local.pmtiles",
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "orbitalgaze-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],

  // Secrets the Worker expects. Values are never stored here: locally they
  // come from .dev.vars, and in hosted environments from Worker secrets.
  // WINDY_API_KEY is optional locally; without it the import jobs skip.
  "secrets": {"required": ["WINDY_API_KEY"]},

  // One trigger per environment keeps staging and production within the
  // shared account quota. The Worker dispatches jobs by UTC time.
  "triggers": {"crons": ["0-55/5 * * * *"]},

  // The import queue. One consumer at a time, ten pages per batch, keeps the
  // load on Windy's API gentle. Queues aren't inherited, so each
  // environment repeats them with its own queue name.
  "queues": {
    "producers": [
      {"binding": "INGEST_QUEUE", "queue": "orbitalgaze-ingest-local"},
    ],
    "consumers": [
      {
        "queue": "orbitalgaze-ingest-local",
        "max_batch_size": 10,
        "max_concurrency": 1,
        "max_retries": 3,
      },
    ],
  },

  // CAMERA_INDEX holds the prebuilt camera index file the globe loads.
  // LAYER_SNAPSHOTS holds one snapshot file per map layer
  // (layers/<id>/v1.json), rewritten by the layer refresh job. R2 bindings
  // aren't inherited, so each environment repeats them.
  "r2_buckets": [
    {
      "binding": "CAMERA_INDEX",
      "bucket_name": "orbitalgaze-camera-index-local",
    },
    {
      "binding": "LAYER_SNAPSHOTS",
      "bucket_name": "orbitalgaze-layer-snapshots-local",
    },
    {
      "binding": "BASEMAP",
      "bucket_name": "orbitalgaze-basemap-local",
    },
  ],

  // Per-address request budgets (see src/worker/lib/rate_limit.ts). Rate
  // limits aren't inherited, so each environment repeats them.
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {"limit": 300, "period": 60},
    },
    {
      "name": "SEARCH_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {"limit": 30, "period": 60},
    },
    {
      "name": "TILES_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": {"limit": 2400, "period": 60},
    },
  ],

  "env": {
    "staging": {
      "name": "orbitalgaze-staging",
      "account_id": "9fe808d792b2aa8f095351f40b89c3eb",
      // Served only at staging.orbitalgaze.com; no workers.dev or preview
      // URLs, so there is one address to protect and test.
      "routes": [{"pattern": "staging.orbitalgaze.com", "custom_domain": true}],
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "APP_ENV": "staging",
        "BASEMAP_ARCHIVE": "planet/20261118.pmtiles",
      },
      "secrets": {"required": ["WINDY_API_KEY"]},
      "queues": {
        "producers": [
          {"binding": "INGEST_QUEUE", "queue": "orbitalgaze-ingest-staging"},
        ],
        "consumers": [
          {
            "queue": "orbitalgaze-ingest-staging",
            "max_batch_size": 10,
            "max_concurrency": 1,
            "max_retries": 3,
          },
        ],
      },
      "r2_buckets": [
        {
          "binding": "CAMERA_INDEX",
          "bucket_name": "orbitalgaze-camera-index-staging",
        },
        {
          "binding": "LAYER_SNAPSHOTS",
          "bucket_name": "orbitalgaze-layer-snapshots-staging",
        },
        {
          "binding": "BASEMAP",
          "bucket_name": "orbitalgaze-basemap-staging",
        },
      ],
      "ratelimits": [
        {
          "name": "API_RATE_LIMITER",
          "namespace_id": "2001",
          "simple": {"limit": 300, "period": 60},
        },
        {
          "name": "SEARCH_RATE_LIMITER",
          "namespace_id": "2002",
          "simple": {"limit": 30, "period": 60},
        },
        {
          "name": "TILES_RATE_LIMITER",
          "namespace_id": "2003",
          "simple": {"limit": 2400, "period": 60},
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "orbitalgaze-staging",
          "database_id": "8cc224b9-faca-4785-b740-44fa274acb59",
          "migrations_dir": "migrations",
        },
      ],
    },
    "production": {
      "name": "orbitalgaze",
      "account_id": "9fe808d792b2aa8f095351f40b89c3eb",
      // Served only at orbitalgaze.com. www.orbitalgaze.com never reaches
      // the Worker: a zone redirect rule sends it to orbitalgaze.com.
      "routes": [{"pattern": "orbitalgaze.com", "custom_domain": true}],
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "APP_ENV": "production",
        "BASEMAP_ARCHIVE": "planet/20261118.pmtiles",
      },
      "secrets": {"required": ["WINDY_API_KEY"]},
      "queues": {
        "producers": [
          {"binding": "INGEST_QUEUE", "queue": "orbitalgaze-ingest-production"},
        ],
        "consumers": [
          {
            "queue": "orbitalgaze-ingest-production",
            "max_batch_size": 10,
            "max_concurrency": 1,
            "max_retries": 3,
          },
        ],
      },
      "r2_buckets": [
        {
          "binding": "CAMERA_INDEX",
          "bucket_name": "orbitalgaze-camera-index-production",
        },
        {
          "binding": "LAYER_SNAPSHOTS",
          "bucket_name": "orbitalgaze-layer-snapshots-production",
        },
        {
          "binding": "BASEMAP",
          "bucket_name": "orbitalgaze-basemap-production",
        },
      ],
      "ratelimits": [
        {
          "name": "API_RATE_LIMITER",
          "namespace_id": "3001",
          "simple": {"limit": 300, "period": 60},
        },
        {
          "name": "SEARCH_RATE_LIMITER",
          "namespace_id": "3002",
          "simple": {"limit": 30, "period": 60},
        },
        {
          "name": "TILES_RATE_LIMITER",
          "namespace_id": "3003",
          "simple": {"limit": 2400, "period": 60},
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "orbitalgaze-production",
          "database_id": "33c9f5e7-f452-457f-ac04-f8cdd4989fd8",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
